---
import { FORM, CONTACT, SITE } from '../consts';
const configured = Boolean(FORM.endpoint && (FORM.accessKey || !FORM.endpoint.includes('web3forms')));
---

<div class="cf">
  {
    configured ? (
      <Fragment>
      <form class="cf__form" action={FORM.endpoint} method="POST">
        {FORM.accessKey && <input type="hidden" name="access_key" value={FORM.accessKey} />}
        <input type="hidden" name="subject" value={`[${SITE.name}] 상담신청`} />
        {/* 스팸봇 차단용 허니팟 — 사람 눈에는 안 보입니다 */}
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

        <div class="cf__row">
          <label class="cf__field">
            <span>성함 <em>*</em></span>
            <input type="text" name="이름" required autocomplete="name" placeholder="성함" />
          </label>
          <label class="cf__field">
            <span>연락처 <em>*</em></span>
            <input type="tel" name="연락처" required autocomplete="tel" placeholder="010-0000-0000" />
          </label>
        </div>

        <div class="cf__row">
          <label class="cf__field">
            <span>학생 신분</span>
            <select name="구분">
              <option>가해학생으로 지목됨</option>
              <option>피해학생</option>
              <option>양쪽 모두 신고됨(쌍방)</option>
              <option>아직 판단이 어려움</option>
            </select>
          </label>
          <label class="cf__field">
            <span>현재 단계</span>
            <select name="단계">
              <option>학교 신고 접수 직후</option>
              <option>사안조사·진술 단계</option>
              <option>심의위원회 개최 예정</option>
              <option>조치 처분을 받음(불복 검토)</option>
              <option>수사·소년보호 절차 진행 중</option>
            </select>
          </label>
        </div>

        <label class="cf__field">
          <span>상담 내용 <em>*</em></span>
          <textarea
            name="내용"
            rows="6"
            required
            placeholder="언제, 어떤 일이 있었고 지금 어떤 상황인지 적어주세요. 학교로부터 받은 통지서가 있다면 그 내용도 함께 적어주시면 상담이 빨라집니다."
          />
        </label>

        <label class="cf__check">
          <input type="checkbox" name="개인정보동의" value="동의함" required />
          <span>
            상담 진행을 위한 개인정보(성함·연락처·상담내용) 수집·이용에 동의합니다. 수집된 정보는
            상담 목적으로만 이용하며 상담 종료 후 지체 없이 파기합니다.
            <a href="/privacy/">자세히 보기</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primary cf__submit">상담 신청하기</button>
        <p class="cf__hint">
          접수 후 영업일 기준 1일 이내에 연락드립니다. 급한 사안은 <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a> 로 바로 전화 주세요.
        </p>
      </form>

      {/* 전송 결과 팝업. 자바스크립트가 동작할 때만 열립니다. */}
      <dialog class="cfd" id="cf-dialog" aria-labelledby="cf-dialog-title">
        <div class="cfd__inner">
          <p class="cfd__icon" data-cfd-icon aria-hidden="true">✓</p>
          <h2 class="cfd__title" id="cf-dialog-title" data-cfd-title>상담 신청이 접수되었습니다</h2>
          <p class="cfd__body" data-cfd-body>
            영업일 기준 1일 이내에 연락드리겠습니다. 사안이 급하시면 전화로 바로 연락 주세요.
          </p>
          <div class="cfd__actions">
            <a class="btn btn--primary" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone} 전화하기</a>
            <button type="button" class="btn btn--ghost" data-cfd-close>닫기</button>
          </div>
        </div>
      </dialog>
      </Fragment>
    ) : (
      <div class="cf__fallback">
        <p><strong>상담 폼이 아직 연결되지 않았습니다.</strong></p>
        <p class="cf__hint">
          <code>src/consts.ts</code> 의 <code>FORM.accessKey</code> 에 폼 서비스 키를 넣으면 이 자리에 신청 폼이 나타납니다.
          그때까지는 전화·카카오톡 상담을 안내합니다.
        </p>
        <div class="cf__buttons">
          <a class="btn btn--primary" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone} 전화상담</a>
          {CONTACT.kakao && (
            <a class="btn btn--kakao" href={CONTACT.kakao} target="_blank" rel="noopener">
              카카오톡 상담
            </a>
          )}
        </div>
      </div>
    )
  }
</div>

<style>
  .cf {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .cf__row {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .cf__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cf__field {
    display: block;
    margin-bottom: 1rem;
  }
  .cf__field > span {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-2);
    margin-bottom: 0.4rem;
  }
  .cf__field em {
    color: var(--danger);
    font-style: normal;
  }
  .cf input[type='text'],
  .cf input[type='tel'],
  .cf select,
  .cf textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--ink);
  }
  .cf ::placeholder {
    color: var(--ink-3);
  }
  .cf textarea {
    resize: vertical;
    line-height: 1.7;
  }
  .cf input:focus,
  .cf select:focus,
  .cf textarea:focus {
    border-color: var(--accent);
  }
  .cf__check {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0.5rem 0 1.25rem;
  }
  .cf__check input {
    margin-top: 0.25rem;
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--accent);
  }
  .cf__submit {
    width: 100%;
  }
  .cf__hint {
    font-size: 0.8125rem;
    color: var(--ink-3);
    margin: 0.9rem 0 0;
    text-align: center;
  }
  /* ── 전송 결과 팝업 ─────────────────────── */
  .cfd {
    width: min(420px, calc(100vw - 2.5rem));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
  }
  .cfd::backdrop {
    background: rgba(4, 5, 6, 0.72);
  }
  .cfd__inner {
    padding: clamp(1.5rem, 4vw, 2rem);
    text-align: center;
  }
  .cfd__icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 1.4rem;
    font-weight: 800;
    background: var(--accent);
    color: #17130a;
  }
  .cfd[data-state='error'] .cfd__icon {
    background: var(--danger);
    color: #fff;
  }
  .cfd__title {
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }
  .cfd__body {
    font-size: 0.9375rem;
    color: var(--ink-2);
    margin: 0 0 1.5rem;
    line-height: 1.7;
  }
  .cfd__actions {
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 420px) {
    .cfd__actions {
      grid-template-columns: 1fr auto;
    }
  }
  /* 전송 중에는 버튼을 잠급니다 */
  .cf__form[data-sending] .cf__submit {
    opacity: 0.6;
    pointer-events: none;
  }

  .cf__fallback code {
    background: var(--surface-2);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .cf__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>

<script>
  /**
   * 상담 신청을 페이지 이동 없이 보냅니다.
   * 자바스크립트가 없거나 실패하면 form 의 기본 동작(Web3Forms 완료 페이지로 이동)이
   * 그대로 남아 있으므로, 어떤 경우에도 신청이 유실되지 않습니다.
   */
  const form = document.querySelector('.cf__form');
  const dialog = document.querySelector('#cf-dialog');

  if (form && dialog && typeof dialog.showModal === 'function') {
    const icon = dialog.querySelector('[data-cfd-icon]');
    const title = dialog.querySelector('[data-cfd-title]');
    const body = dialog.querySelector('[data-cfd-body]');
    const submit = form.querySelector('.cf__submit');
    const closeBtn = dialog.querySelector('[data-cfd-close]');
    const defaultLabel = submit.textContent;

    function open(state, headline, message) {
      dialog.dataset.state = state;
      icon.textContent = state === 'ok' ? '✓' : '!';
      title.textContent = headline;
      body.textContent = message;
      dialog.showModal();
    }

    if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (form.dataset.sending) return;

      form.dataset.sending = 'true';
      submit.textContent = '보내는 중…';

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        let data = {};
        try { data = await res.json(); } catch (err) { data = {}; }

        if (res.ok && data.success) {
          form.reset();
          open(
            'ok',
            '상담 신청이 접수되었습니다',
            '영업일 기준 1일 이내에 연락드리겠습니다. 사안이 급하시면 전화로 바로 연락 주세요.'
          );
        } else {
          open(
            'error',
            '전송하지 못했습니다',
            '일시적인 오류로 신청이 접수되지 않았습니다. 잠시 후 다시 시도하시거나 전화로 연락 주세요. 작성하신 내용은 그대로 남아 있습니다.'
          );
        }
      } catch (err) {
        open(
          'error',
          '전송하지 못했습니다',
          '네트워크 연결을 확인하신 뒤 다시 시도해 주세요. 급하시면 전화로 바로 연락 주세요. 작성하신 내용은 그대로 남아 있습니다.'
        );
      } finally {
        delete form.dataset.sending;
        submit.textContent = defaultLabel;
      }
    });
  }
</script>
