---
/**
 * 모바일 하단 고정 상담 버튼.
 * 학교폭력 사건 유입은 대부분 모바일이고, 전화 한 통이 전환의 전부입니다.
 */
import { CONTACT } from '../consts';
---

<div class="cta-bar">
  <a class="cta-bar__btn cta-bar__btn--call" href={`tel:${CONTACT.phoneHref}`}>
    <span aria-hidden="true">📞</span> 전화상담
  </a>
  {
    CONTACT.kakao && (
      <a class="cta-bar__btn cta-bar__btn--kakao" href={CONTACT.kakao} target="_blank" rel="noopener">
        <span aria-hidden="true">💬</span> 카카오톡
      </a>
    )
  }
  <a class="cta-bar__btn cta-bar__btn--form" href="/contact/">
    <span aria-hidden="true">✎</span> 상담신청
  </a>
</div>

<style>
  .cta-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    background: var(--surface);
    border-top: 1px solid var(--line-strong);
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.5);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .cta-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    padding: 0.95rem 0.4rem;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--heading);
  }
  .cta-bar__btn + .cta-bar__btn {
    border-left: 1px solid var(--line);
  }
  /* 카카오 노랑 옆에 골드를 나란히 두면 탁해 보여서,
     밝은 블록은 카카오 하나만 두고 전화는 골드 글씨로 강조합니다. */
  .cta-bar__btn--call {
    background: var(--surface-2);
    color: var(--accent);
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .cta-bar__btn--kakao {
    background: #fee500;
    color: #191600;
  }

  @media (min-width: 900px) {
    .cta-bar {
      display: none;
    }
  }
</style>
