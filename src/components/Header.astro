---
import { SITE, CONTACT, NAV } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="hd">
  <div class="wrap hd__inner">
    <a class="hd__brand" href="/">
      <svg class="hd__mark" viewBox="0 0 64 64" aria-hidden="true">
        <g stroke="currentColor" stroke-width="4.2" stroke-linecap="round" fill="none">
          <path d="M32 16V49" />
          <path d="M14 20h36" />
          <path d="M21 52h22" />
        </g>
        <circle cx="32" cy="14.5" r="4.4" fill="currentColor" />
        <path d="M7 24h14a7 7 0 0 1-14 0z" fill="currentColor" />
        <path d="M43 24h14a7 7 0 0 1-14 0z" fill="currentColor" />
      </svg>
      <span class="hd__name">{SITE.name}</span>
      <span class="hd__divider" aria-hidden="true"></span>
      {/* 로고 PNG 한 장을 두 번 그립니다. 글자 부분은 흰색으로 반전하고 오른쪽 도장은 원색으로 겹칩니다. */}
      <span class="hd__firm">
        <img class="hd__firm-text" src="/images/logos/jeonghyang.png" alt={SITE.legalName} width="573" height="126" />
        <img class="hd__firm-stamp" src="/images/logos/jeonghyang.png" alt="" width="573" height="126" aria-hidden="true" />
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="visually-hidden hd__check" />
    <label for="nav-toggle" class="hd__burger">
      <span aria-hidden="true"></span>
      <span class="visually-hidden">메뉴 열기</span>
    </label>

    <nav class="hd__nav" aria-label="주요 메뉴">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="hd__tel" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
    </nav>
  </div>
</header>

<style>
  /* 첫 화면의 검정 히어로와 이어지도록 헤더도 다크로 통일 */
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 9, 11, 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--dark-line);
  }
  .hd__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .hd__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 1.0625rem;
    color: var(--dark-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-right: auto;
  }
  .hd__mark {
    width: 24px;
    height: 24px;
    flex: none;
    color: var(--gold);
  }
  .hd__divider {
    flex: none;
    width: 1px;
    height: 24px;
    margin: 0 0.15rem;
    background: rgba(255, 255, 255, 0.3);
  }
  .hd__firm {
    position: relative;
    display: flex;
    align-items: center;
    height: 34px;
    flex: none;
  }
  .hd__firm img {
    display: block;
    height: 100%;
    width: auto;
  }
  /* 글자 부분: 흰색으로 반전, 오른쪽 8% 도장 영역은 잘라냄 */
  .hd__firm-text {
    filter: brightness(0) invert(1);
    clip-path: inset(0 8% 0 0);
    opacity: 0.95;
  }
  /* 도장 부분: 원색 유지, 왼쪽 92% 글자 영역은 잘라냄 */
  .hd__firm-stamp {
    position: absolute;
    top: 0;
    left: 0;
    clip-path: inset(0 0 0 92%);
  }
  /* 좁은 화면: 브랜드명이 길어 전체 로고를 두면 메뉴 버튼이 둘째 줄로 밀립니다.
     로고 오른쪽 절반(正向 글씨 + 도장)만 보이도록 잘라 씁니다. */
  @media (max-width: 480px) {
    .hd__firm {
      height: 24px;
      width: 53px;
      overflow: hidden;
      justify-content: flex-end;
    }
    .hd__firm img {
      max-width: none;
    }
    .hd__firm-stamp {
      left: auto;
      right: 0;
    }
    .hd__divider {
      height: 18px;
      margin: 0;
    }
  }

  .hd__nav ul {
    list-style: none;
    display: flex;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
  }
  .hd__nav a {
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--dark-ink-2);
    white-space: nowrap;
  }
  .hd__nav a:hover,
  .hd__nav a[aria-current='page'] {
    color: #fff;
  }
  .hd__nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
  }
  .hd__tel {
    display: none;
  }

  /* 데스크톱 */
  @media (min-width: 900px) {
    .hd__nav {
      display: flex;
      align-items: center;
      gap: 1.6rem;
    }
    .hd__burger {
      display: none;
    }
    .hd__tel {
      display: inline-block;
      font-weight: 800;
      color: var(--gold);
      text-decoration: none;
      font-size: 1rem;
      padding-left: 1.2rem;
      border-left: 1px solid var(--dark-line);
    }
  }

  /* 모바일 — CSS만으로 여닫는 메뉴 (JS 0KB) */
  @media (max-width: 899px) {
    .hd__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 1px solid var(--dark-line);
      border-radius: 10px;
      cursor: pointer;
    }
    .hd__burger span[aria-hidden] {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--dark-ink);
      position: relative;
    }
    .hd__burger span[aria-hidden]::before,
    .hd__burger span[aria-hidden]::after {
      content: '';
      position: absolute;
      left: 0;
      width: 18px;
      height: 2px;
      background: var(--dark-ink);
    }
    .hd__burger span[aria-hidden]::before {
      top: -6px;
    }
    .hd__burger span[aria-hidden]::after {
      top: 6px;
    }

    .hd__nav {
      display: none;
      width: 100%;
      padding-bottom: 1rem;
    }
    .hd__check:checked ~ .hd__nav {
      display: block;
    }
    .hd__nav ul {
      flex-direction: column;
      gap: 0;
      border-top: 1px solid var(--dark-line);
    }
    .hd__nav li + li {
      border-top: 1px solid var(--dark-line);
    }
    .hd__nav a {
      display: block;
      padding: 0.85rem 0.25rem;
      font-size: 1rem;
    }
  }
</style>
