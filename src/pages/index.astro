---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CtaSection from '../components/CtaSection.astro';
import Faq from '../components/Faq.astro';
import { SITE, CONTACT, ATTORNEY, CREDENTIALS } from '../consts';
import { faqSchema } from '../lib/schema';

const services = (await getCollection('service', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const columns = (await getCollection('column', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const cases = (await getCollection('case', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const homeFaq = [
  {
    q: '학교폭력 사건에 변호사가 꼭 필요한가요?',
    a: '학교폭력대책심의위원회는 형사재판과 달리 서면과 진술 위주로 짧은 시간 안에 결론이 나고, 한 번 내려진 조치는 생활기록부에 기재되어 상급학교 진학까지 영향을 줍니다. 사안조사 단계에서 무엇을 어떻게 진술하느냐가 결과를 좌우하기 때문에, 통지서를 받은 시점에 상담을 받아보시는 것을 권합니다.',
  },
  {
    q: '언제 상담받는 것이 가장 좋나요?',
    a: '학교로부터 학교폭력 사안 접수 사실을 통보받은 직후가 가장 좋습니다. 이미 진술서를 제출했거나 심의위원회가 끝난 뒤라도 조치 통보를 받은 날부터 90일 이내라면 행정심판·행정소송으로 다툴 수 있으므로 늦었다고 판단하지 마시고 문의해 주세요.',
  },
  {
    q: '심의위원회에 변호사가 함께 들어갈 수 있나요?',
    a: '학생과 보호자는 심의위원회에 출석하여 의견을 진술할 수 있고, 대리인을 선임할 수 있습니다. 다만 위원회 운영 방식에 따라 진술 시간과 대리인 참여 범위가 달라질 수 있어, 사전에 서면 의견서를 충실히 준비하는 것이 중요합니다.',
  },
  {
    q: '상담 비용은 어떻게 되나요?',
    a: '초기 상담에서 사건의 쟁점과 예상 절차, 비용을 먼저 안내드립니다. 비용은 사건 유형(심의위원회 대응, 행정심판, 소송 등)과 진행 단계에 따라 달라지므로 상담 시 구체적으로 말씀드립니다.',
  },
];

const heroPoints = [
  { n: '01', t: '통지서를 받은 그날부터', d: '사안조사 진술, 확인서 작성, 증거 정리까지 첫 대응 방향을 잡아드립니다.' },
  { n: '02', t: '심의위원회 서면·출석 대응', d: '의견서와 자료를 구조적으로 정리해 위원회가 사실관계를 오해하지 않도록 합니다.' },
  { n: '03', t: '조치 처분 불복', d: '행정심판·행정소송, 집행정지 신청까지 생활기록부 기재를 다투는 절차를 진행합니다.' },
];
---

<BaseLayout
  title={`학교폭력 변호사 | ${SITE.name}`}
  description={SITE.description}
  bareTitle
  jsonLd={[faqSchema(homeFaq)]}
>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <div class="hero__text">
        <span class="hero__eyebrow">학교폭력 전담</span>
        <h1>아이의 3년이<br /><em>몇 주 안에</em> 결정됩니다</h1>
        <p class="hero__lead">
          학교폭력 사건은 신고 접수부터 조치 결정까지 길지 않습니다. 그 사이에 쓴 진술서 한 장이
          조치 수위를 바꾸고, 그 조치는 생활기록부에 남습니다.
        </p>
        <div class="hero__actions">
          <a class="hero__cta hero__cta--primary" href={`tel:${CONTACT.phoneHref}`}>
            {CONTACT.phone} 전화상담
          </a>
          <a class="hero__cta hero__cta--ghost" href="/contact/">온라인 상담신청</a>
        </div>
        <p class="hero__hours">상담시간 {CONTACT.hours} · 사안이 급하면 시간 외에도 연락 주세요</p>
      </div>

      <div class="hero__photo">
        <picture>
          <source srcset="/images/attorney-hero.webp" type="image/webp" />
          <img
            src="/images/attorney-hero.jpg"
            alt={`${ATTORNEY.name} ${ATTORNEY.jobTitle}`}
            width="1000"
            height="1328"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>

    <div class="creds">
      <div class="wrap creds__inner">
        {
          CREDENTIALS.map((c) => (
            <div class="creds__item">
              <strong>{c.label}</strong>
              <span>{c.detail}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="steps3">
    <div class="wrap">
      <ol>
        {
          heroPoints.map((p) => (
            <li>
              <span class="steps3__num">{p.n}</span>
              <strong>{p.t}</strong>
              <p>{p.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">업무분야</span>
        <h2>사건의 단계와 지위에 따라 대응이 달라집니다</h2>
        <p>지금 어느 단계에 계신지 선택하시면, 그 상황에서 필요한 절차와 준비 사항을 정리해 두었습니다.</p>
      </div>
      <div class="grid grid--3">
        {
          services.map((s) => (
            <PostCard
              href={`/service/${s.id}/`}
              title={s.data.shortTitle}
              description={s.data.summary}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">절차 안내</span>
        <h2>학교폭력 사건은 이렇게 진행됩니다</h2>
        <p>
          신고 접수부터 조치 결정, 그리고 불복까지. 전체 흐름을 먼저 이해하셔야 지금 무엇을 준비해야
          하는지가 보입니다.
        </p>
      </div>
      <a class="btn btn--primary" href="/school-violence/">학교폭력 절차 전체 보기</a>
    </div>
  </section>

  {
    cases.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow">해결사례</span>
            <h2>실제로 어떻게 다투었는지 보여드립니다</h2>
            <p>
              의뢰인이 특정되지 않도록 사건 내용을 각색·일반화하여 정리했습니다. 결과는 구체적
              사실관계에 따라 달라질 수 있습니다.
            </p>
          </div>
          <div class="grid grid--3">
            {cases.map((c) => (
              <PostCard
                href={`/case/${c.id}/`}
                title={c.data.title}
                description={c.data.description}
                tag={c.data.category}
                tagAccent
                note={c.data.outcome}
                date={c.data.publishDate}
              />
            ))}
          </div>
          <p class="more">
            <a href="/case/">해결사례 전체 보기 →</a>
          </p>
        </div>
      </section>
    )
  }

  {
    columns.length > 0 && (
      <section class="section section--soft">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow">칼럼</span>
            <h2>자주 받는 질문을 글로 정리했습니다</h2>
          </div>
          <div class="grid grid--3">
            {columns.map((c) => (
              <PostCard
                href={`/column/${c.id}/`}
                title={c.data.title}
                description={c.data.description}
                tag={c.data.category}
                date={c.data.publishDate}
              />
            ))}
          </div>
          <p class="more">
            <a href="/column/">칼럼 전체 보기 →</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap" style="max-width: var(--maxw-prose); margin-inline: auto;">
      <Faq items={homeFaq} />
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  /* ── 첫 화면 (다크) ───────────────────────── */
  .hero {
    position: relative;
    background: var(--dark-bg);
    color: var(--dark-ink);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(720px 420px at 12% 8%, rgba(217, 178, 106, 0.13), transparent 68%),
      radial-gradient(560px 420px at 78% 90%, rgba(64, 96, 148, 0.18), transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0;
    padding-top: clamp(2.75rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.08fr 0.92fr;
      align-items: end;
      gap: 2rem;
    }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--gold);
    margin-bottom: 1.4rem;
  }
  .hero__eyebrow::before {
    content: '';
    width: 34px;
    height: 2px;
    background: var(--gold);
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(2.15rem, 1.15rem + 4vw, 4rem);
    line-height: 1.16;
    letter-spacing: -0.04em;
    margin-bottom: 1.15rem;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--gold);
  }
  .hero__lead {
    color: var(--dark-ink-2);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    max-width: 27em;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95em 1.7em;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .hero__cta--primary {
    background: var(--gold);
    color: #17130a;
  }
  .hero__cta--primary:hover {
    background: #e6c281;
    color: #17130a;
  }
  .hero__cta--ghost {
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .hero__cta--ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }
  .hero__hours {
    font-size: 0.8125rem;
    color: #7c8697;
    margin: 1.1rem 0 0;
  }

  .hero__photo {
    position: relative;
    width: 100%;
    max-width: 260px;
    margin: 1.5rem auto 0;
    align-self: end;
  }
  /* 좁은 화면에서는 히어로가 길어지지 않도록 조입니다 */
  @media (max-width: 899px) {
    .hero__inner {
      padding-top: 2.25rem;
    }
    .hero__lead {
      margin-bottom: 1.5rem;
    }
    .hero__cta {
      font-size: 0.875rem;
      padding: 0.85em 1.15em;
    }
  }
  @media (min-width: 900px) {
    .hero__photo {
      max-width: 440px;
      margin: 0 0 0 auto;
    }
  }
  .hero__photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* 사진 가장자리를 검정으로 녹여서 인물이 어둠에서 떠오르게 */
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 50% at 52% 38%, rgba(8, 9, 11, 0) 34%, rgba(8, 9, 11, 0.55) 62%, var(--dark-bg) 88%),
      linear-gradient(to top, rgba(8, 9, 11, 0) 74%, var(--dark-bg) 100%),
      linear-gradient(to bottom, rgba(8, 9, 11, 0) 46%, var(--dark-bg) 96%);
    pointer-events: none;
  }

  /* 자격 스트립 */
  .creds {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--dark-line);
  }
  .creds__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.6rem;
    padding-block: 1rem;
  }
  .creds__item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding-block: 0.35rem;
    font-size: 0.8125rem;
    position: relative;
  }
  .creds__item + .creds__item::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-50%);
  }
  .creds__item strong {
    color: var(--gold);
    font-weight: 700;
    white-space: nowrap;
  }
  .creds__item span {
    color: var(--dark-ink-2);
  }

  /* ── 히어로 아래 3단계 ─────────────────────── */
  .steps3 {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .steps3 ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(2.25rem, 4vw, 3rem);
  }
  @media (min-width: 780px) {
    .steps3 ol {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  .steps3 li {
    padding-top: 1rem;
    border-top: 2px solid var(--navy-100);
  }
  .steps3__num {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .steps3 strong {
    display: block;
    color: var(--navy-900);
    margin-bottom: 0.3rem;
  }
  .steps3 p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .more {
    margin: 2rem 0 0;
  }
  .more a {
    font-weight: 700;
    text-decoration: none;
  }
</style>
