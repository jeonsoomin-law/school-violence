---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE, CONTACT, ATTORNEY, CREDENTIALS, CREDENTIAL_LOGOS } from '../consts';

const services = (await getCollection('service', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const cases = (await getCollection('case', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

/** 홈 중간 사진 밴드. 실제 사건 사진이 아니라 상황을 표현한 이미지입니다. */
const shots = [
  { src: '/images/scene-classroom', alt: '해질 무렵 빈 교실에 혼자 앉아 있는 학생', cap: '아이는 먼저 말하지 않습니다' },
  { src: '/images/scene-hallway', alt: '아무도 없는 학교 복도와 사물함', cap: '학교는 조용히 절차를 진행합니다' },
  { src: '/images/scene-phone', alt: '어두운 방에서 휴대폰 화면을 보고 있는 손', cap: '기록은 화면 안에 남아 있습니다' },
];

/** 사진 밴드 아래 절차 흐름. 단계 설명은 /school-violence/ 의 steps 와 맞춰 둡니다. */
const flow = [
  { t: '신고 · 접수', d: '보호자 통지, 교육청 사안보고' },
  { t: '초기 조사', d: '학생·보호자 확인서 작성' },
  { t: '전담조사관 조사', d: '면담 후 조사 결과 보고서 작성' },
  { t: '학교폭력 전담기구', d: '학교장 자체해결 여부 판단' },
  { t: '학교폭력대책심의위원회', d: '학교폭력 여부와 조치 결정' },
  { t: '행정심판 · 행정소송', d: '조치에 대한 불복 절차' },
];
---

<BaseLayout
  title="학교폭력변호사 | 전수민"
  description={SITE.description}
  bareTitle
>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1>
          <span class="hero__kw">교사 · 서울시교육청 출신 학교폭력변호사 전수민</span>
          {/* 900px 이상에서만 <br> 이 보이므로, 좁은 화면에서 단어가 붙지 않게 띄어쓰기를 태그 앞에 둡니다 */}
          전수민 변호사는 <br class="hero__br" />전공, 경력, 소송수행 및 <br class="hero__br" />사건 처리 경험에서 차별화된 <br class="hero__br" /><em>학교폭력 전문 변호사</em>입니다.
        </h1>
        <p class="hero__lead">
          학교폭력 사건은 상대학생 측의 주장, 학교의 입장 등 고려할 점이 너무나 많고, 조심스럽게
          접근해야 합니다. 신고접수, 초기 진술서 작성, 전담조사관 조사, 학교폭력전담기구, 학폭위 개최
          등 매 단계에서 전문가의 밀착 조력이 필요합니다.
        </p>
        <div class="hero__actions">
          <a class="hero__cta hero__cta--primary" href={`tel:${CONTACT.phoneHref}`}>
            {CONTACT.phone} 전화상담
          </a>
          <a class="hero__cta hero__cta--ghost" href="/contact/">온라인 상담신청</a>
        </div>
        <p class="hero__hours">상담시간 {CONTACT.hours} · 사안이 급하면 시간 외에도 연락 주세요</p>
      </div>

      <div class="hero__photo">
        <picture>
          <source srcset="/images/attorney-hero.webp" type="image/webp" />
          <img
            src="/images/attorney-hero.jpg"
            alt={`${ATTORNEY.name} ${ATTORNEY.jobTitle}`}
            width="1000"
            height="1328"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>

    <div class="creds">
      <div class="wrap creds__inner">
        {
          CREDENTIALS.map((c) => (
            <div class="creds__item">
              <strong>{c.label}</strong>
              <span>{c.detail}</span>
            </div>
          ))
        }
      </div>
      <div class="wrap creds__logos">
        <span class="creds__logos-label">위촉 · 자문 · 연수 기관</span>
        <ul class="creds__logo-list">
          {
            CREDENTIAL_LOGOS.map((l) => (
              <li class="creds__logo" style={'scale' in l ? `--s:${l.scale}` : undefined}>
                <img src={l.src} alt={l.name} width={l.w} height={l.h} loading="lazy" decoding="async" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="shots">
    <div class="wrap shots__inner">
      {
        shots.map((s) => (
          <figure class="shots__item">
            <picture>
              <source srcset={`${s.src}.webp`} type="image/webp" />
              <img src={`${s.src}.jpg`} alt={s.alt} width="900" height="600" loading="lazy" decoding="async" />
            </picture>
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="pledge">
    <div class="wrap pledge__inner">
      <blockquote class="pledge__quote">
        <p>
          상담하는 변호사와 사건수행 변호사가 다르지 않고, <strong>전수민 변호사가 직접 상담부터 사건 수행까지 모든 절차를 함께 합니다.</strong>
        </p>
      </blockquote>

      <div class="flow__head">
        <span class="eyebrow">학교폭력 사건 처리 절차</span>
        <a href="/school-violence/">단계별 자세히 보기 →</a>
      </div>
      <ol class="flow">
        {
          flow.map((f) => (
            <li class="flow__item">
              <span class="flow__num" aria-hidden="true" />
              <strong class="flow__t">{f.t}</strong>
              <span class="flow__d">{f.d}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">업무분야</span>
        <h2>사건의 단계와 지위에 따라 대응이 달라집니다</h2>
        <p>지금 어느 단계에 계신지 선택하시면, 그 상황에서 필요한 절차와 준비 사항을 정리해 두었습니다.</p>
      </div>
      <div class="grid grid--3">
        {
          services.map((s) => (
            <PostCard
              href={`/service/${s.id}/`}
              title={s.data.shortTitle}
              description={s.data.summary}
            />
          ))
        }
      </div>
      <p class="more">
        <a href="/school-violence/">신고 접수부터 불복까지, 학교폭력 절차 전체 보기 →</a>
      </p>
    </div>
  </section>


  {
    cases.length > 0 && (
      <section class="section section--soft">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow">해결사례</span>
            <h2>전수민 변호사가 수행하여 좋은 결과를 냈던 사건의 일부입니다.</h2>
            <p>
              의뢰인이 특정되지 않도록 사건 내용을 각색·일반화하여 정리했습니다. 결과는 구체적
              사실관계에 따라 달라질 수 있습니다.
            </p>
          </div>
          <div class="grid grid--3">
            {cases.map((c) => (
              <PostCard
                href={`/case/${c.id}/`}
                title={c.data.title}
                description={c.data.description}
                tag={c.data.category}
                tagAccent
                note={c.data.outcome}
                date={c.data.publishDate}
              />
            ))}
          </div>
          <p class="more">
            <a href="/case/">해결사례 전체 보기 →</a>
          </p>
        </div>
      </section>
    )
  }

  <CtaSection />
</BaseLayout>

<style>
  /* ── 첫 화면 (다크) ───────────────────────── */
  .hero {
    position: relative;
    background: var(--dark-bg);
    color: var(--dark-ink);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(720px 420px at 12% 8%, rgba(217, 178, 106, 0.13), transparent 68%),
      radial-gradient(560px 420px at 78% 90%, rgba(64, 96, 148, 0.18), transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0;
    padding-top: clamp(2.75rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.08fr 0.92fr;
      /* 사진은 아래 가장자리가 배경에 녹아들어야 하므로 바닥 고정 */
      align-items: end;
      gap: 2rem;
    }
    /* 사진이 텍스트보다 커서 end 정렬이면 문구가 아래로 밀립니다 — 문구만 가운데로 */
    .hero__text {
      align-self: center;
    }
  }

  /* 라벨을 h1 안에 넣어 주요 키워드가 h1 에 잡히게 합니다.
     보이는 모습은 기존 eyebrow 와 동일합니다. */
  .hero__kw {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.5;
    color: var(--gold);
    margin-bottom: 1.4rem;
  }
  .hero__kw::before {
    content: '';
    flex: none;
    width: 34px;
    height: 2px;
    background: var(--gold);
  }

  .hero h1 {
    color: #fff;
    /* 문장형 헤드라인이라 예전 구호형보다 한 단계 작게, 900px 이상에서는 네 줄로 고정 */
    font-size: clamp(1.7rem, 0.4rem + 2.7vw, 2.75rem);
    line-height: 1.24;
    letter-spacing: -0.035em;
    margin-bottom: 1.15rem;
  }
  .hero__br {
    display: none;
  }
  @media (min-width: 900px) {
    .hero__br {
      display: inline;
    }
  }
  .hero h1 em {
    font-style: normal;
    color: var(--gold);
  }
  .hero__lead {
    color: var(--dark-ink-2);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    max-width: 30em;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95em 1.7em;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .hero__cta--primary {
    background: var(--gold);
    color: #17130a;
  }
  .hero__cta--primary:hover {
    background: #e6c281;
    color: #17130a;
  }
  .hero__cta--ghost {
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .hero__cta--ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }
  .hero__hours {
    font-size: 0.8125rem;
    color: #7c8697;
    margin: 1.1rem 0 0;
  }

  .hero__photo {
    position: relative;
    width: 100%;
    max-width: 260px;
    margin: 1.5rem auto 0;
    align-self: end;
  }
  /* 좁은 화면에서는 히어로가 길어지지 않도록 조입니다 */
  @media (max-width: 899px) {
    .hero__inner {
      padding-top: 2.25rem;
    }
    .hero__lead {
      margin-bottom: 1.5rem;
    }
    .hero__cta {
      font-size: 0.875rem;
      padding: 0.85em 1.15em;
    }
  }
  @media (min-width: 900px) {
    .hero__photo {
      max-width: 440px;
      margin: 0 0 0 auto;
    }
  }
  .hero__photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* 사진 가장자리를 검정으로 녹여서 인물이 어둠에서 떠오르게 */
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 50% at 52% 38%, rgba(8, 9, 11, 0) 34%, rgba(8, 9, 11, 0.55) 62%, var(--dark-bg) 88%),
      linear-gradient(to top, rgba(8, 9, 11, 0) 74%, var(--dark-bg) 100%),
      linear-gradient(to bottom, rgba(8, 9, 11, 0) 46%, var(--dark-bg) 96%);
    pointer-events: none;
  }

  /* 자격 스트립 */
  .creds {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--dark-line);
  }
  .creds__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.6rem;
    padding-block: 1rem;
  }
  .creds__item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding-block: 0.35rem;
    font-size: 0.8125rem;
    position: relative;
  }
  .creds__item + .creds__item::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-50%);
  }
  .creds__item strong {
    color: var(--gold);
    font-weight: 700;
    white-space: nowrap;
  }
  .creds__item span {
    color: var(--dark-ink-2);
  }

  /* 기관 로고 — 공식 색을 그대로 쓰기 위해 밝은 칩 위에 올립니다 */
  .creds__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-block: 0.25rem 1.25rem;
  }
  .creds__logos-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .creds__logo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .creds__logo {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 0.95rem;
    border-radius: 10px;
    background: #f4f6f9;
    opacity: 0.92;
    transition: opacity 0.15s;
  }
  .creds__logo:hover {
    opacity: 1;
  }
  .creds__logo img {
    display: block;
    height: calc(24px * var(--s, 1));
    width: auto;
  }
  @media (max-width: 899px) {
    .creds__logos {
      gap: 0.6rem 1rem;
    }
    .creds__logo {
      height: 40px;
      padding: 0 0.8rem;
    }
    .creds__logo img {
      height: calc(21px * var(--s, 1));
    }
  }

  /* ── 히어로 아래 사진 밴드 ───────────────────── */
  .shots {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .shots__inner {
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  @media (min-width: 760px) {
    .shots__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  .shots__item {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .shots__item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* 다크 테마에 맞춰 살짝 눌러줍니다 */
    filter: saturate(0.75) brightness(0.82);
  }
  .shots__item figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(to top, rgba(8, 9, 11, 0.92), rgba(8, 9, 11, 0));
  }

  /* ── 인용문 + 절차 흐름 ─────────────────────── */
  .pledge {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .pledge__inner {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
  }
  .pledge__quote {
    max-width: 880px;
    margin: 0 0 clamp(2.25rem, 4vw, 3.5rem);
    padding: 0;
  }
  .pledge__quote p {
    margin: 0;
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.7rem);
    line-height: 1.55;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  /* 따옴표는 본문과 같은 크기로, 색만 골드 */
  .pledge__quote p::before,
  .pledge__quote p::after {
    color: var(--gold);
    font-weight: 700;
  }
  .pledge__quote p::before {
    content: '“';
    margin-right: 0.1em;
  }
  .pledge__quote p::after {
    content: '”';
    margin-left: 0.1em;
  }
  .pledge__quote strong {
    color: var(--heading);
    font-weight: 700;
  }

  .flow__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }
  .flow__head .eyebrow {
    margin-bottom: 0;
  }
  .flow__head a {
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    counter-reset: flow;
  }
  .flow__item {
    position: relative;
    counter-increment: flow;
    display: grid;
    gap: 0.15rem;
    padding: 0 0 1.5rem 2rem;
  }
  /* 좁은 화면: 왼쪽 세로 선 + 점 */
  .flow__item::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.6rem;
    bottom: -0.6rem;
    width: 1px;
    background: var(--line-strong);
  }
  .flow__item:last-child::before {
    display: none;
  }
  .flow__item::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .flow__num::before {
    content: counter(flow, decimal-leading-zero);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  .flow__t {
    color: var(--heading);
    font-size: 1rem;
    line-height: 1.35;
  }
  .flow__d {
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  /* 넓은 화면: 여섯 칸을 가로로 놓고 위쪽 선으로 잇습니다 */
  @media (min-width: 900px) {
    .flow {
      grid-template-columns: repeat(6, 1fr);
      gap: 0 1.25rem;
    }
    .flow__item {
      padding: 1.6rem 0 0;
    }
    .flow__item::before {
      display: block;
      left: 0;
      right: -1.25rem;
      top: 5px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .flow__item:last-child::before {
      display: block;
      right: 0;
    }
    .flow__item::after {
      left: 0;
      top: 0;
    }
  }

  .more {
    margin: 2rem 0 0;
  }
  .more a {
    font-weight: 700;
