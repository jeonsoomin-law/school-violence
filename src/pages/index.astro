---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE, CONTACT, ATTORNEY, CREDENTIALS } from '../consts';

const services = (await getCollection('service', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const cases = (await getCollection('case', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

/** 홈 중간 사진 밴드. 실제 사건 사진이 아니라 상황을 표현한 이미지입니다. */
const shots = [
  { src: '/images/scene-classroom', alt: '해질 무렵 빈 교실에 혼자 앉아 있는 학생', cap: '아이는 먼저 말하지 않습니다' },
  { src: '/images/scene-hallway', alt: '아무도 없는 학교 복도와 사물함', cap: '학교는 조용히 절차를 진행합니다' },
  { src: '/images/scene-phone', alt: '어두운 방에서 휴대폰 화면을 보고 있는 손', cap: '기록은 화면 안에 남아 있습니다' },
];
---

<BaseLayout
  title="학교폭력변호사 | 전수민"
  description={SITE.description}
  bareTitle
>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1>
          <span class="hero__kw">교사 · 서울시교육청 출신 학교폭력변호사 전수민</span>
          아이의 3년이<br /><em>몇 주 안에</em> 결정됩니다
        </h1>
        <p class="hero__lead">
          학교폭력 사건은 신고 접수부터 조치 결정까지 길지 않습니다. 그 사이에 쓴 진술서 한 장이
          조치 수위를 바꾸고, 그 조치는 생활기록부에 남습니다.
        </p>
        <div class="hero__actions">
          <a class="hero__cta hero__cta--primary" href={`tel:${CONTACT.phoneHref}`}>
            {CONTACT.phone} 전화상담
          </a>
          <a class="hero__cta hero__cta--ghost" href="/contact/">온라인 상담신청</a>
        </div>
        <p class="hero__hours">상담시간 {CONTACT.hours} · 사안이 급하면 시간 외에도 연락 주세요</p>
      </div>

      <div class="hero__photo">
        <picture>
          <source srcset="/images/attorney-hero.webp" type="image/webp" />
          <img
            src="/images/attorney-hero.jpg"
            alt={`${ATTORNEY.name} ${ATTORNEY.jobTitle}`}
            width="1000"
            height="1328"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>

    <div class="creds">
      <div class="wrap creds__inner">
        {
          CREDENTIALS.map((c) => (
            <div class="creds__item">
              <strong>{c.label}</strong>
              <span>{c.detail}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="shots">
    <div class="wrap shots__inner">
      {
        shots.map((s) => (
          <figure class="shots__item">
            <picture>
              <source srcset={`${s.src}.webp`} type="image/webp" />
              <img src={`${s.src}.jpg`} alt={s.alt} width="900" height="600" loading="lazy" decoding="async" />
            </picture>
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">업무분야</span>
        <h2>사건의 단계와 지위에 따라 대응이 달라집니다</h2>
        <p>지금 어느 단계에 계신지 선택하시면, 그 상황에서 필요한 절차와 준비 사항을 정리해 두었습니다.</p>
      </div>
      <div class="grid grid--3">
        {
          services.map((s) => (
            <PostCard
              href={`/service/${s.id}/`}
              title={s.data.shortTitle}
              description={s.data.summary}
            />
          ))
        }
      </div>
      <p class="more">
        <a href="/school-violence/">신고 접수부터 불복까지, 학교폭력 절차 전체 보기 →</a>
      </p>
    </div>
  </section>


  {
    cases.length > 0 && (
      <section class="section section--soft">
        <div class="wrap">
          <div class="section__head">
            <span class="eyebrow">해결사례</span>
            <h2>실제로 어떻게 다투었는지 보여드립니다</h2>
            <p>
              의뢰인이 특정되지 않도록 사건 내용을 각색·일반화하여 정리했습니다. 결과는 구체적
              사실관계에 따라 달라질 수 있습니다.
            </p>
          </div>
          <div class="grid grid--3">
            {cases.map((c) => (
              <PostCard
                href={`/case/${c.id}/`}
                title={c.data.title}
                description={c.data.description}
                tag={c.data.category}
                tagAccent
                note={c.data.outcome}
                date={c.data.publishDate}
              />
            ))}
          </div>
          <p class="more">
            <a href="/case/">해결사례 전체 보기 →</a>
          </p>
        </div>
      </section>
    )
  }

  <CtaSection />
</BaseLayout>

<style>
  /* ── 첫 화면 (다크) ───────────────────────── */
  .hero {
    position: relative;
    background: var(--dark-bg);
    color: var(--dark-ink);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(720px 420px at 12% 8%, rgba(217, 178, 106, 0.13), transparent 68%),
      radial-gradient(560px 420px at 78% 90%, rgba(64, 96, 148, 0.18), transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0;
    padding-top: clamp(2.75rem, 6vw, 5rem);
  }
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.08fr 0.92fr;
      /* 사진은 아래 가장자리가 배경에 녹아들어야 하므로 바닥 고정 */
      align-items: end;
      gap: 2rem;
    }
    /* 사진이 텍스트보다 커서 end 정렬이면 문구가 아래로 밀립니다 — 문구만 가운데로 */
    .hero__text {
      align-self: center;
    }
  }

  /* 라벨을 h1 안에 넣어 주요 키워드가 h1 에 잡히게 합니다.
     보이는 모습은 기존 eyebrow 와 동일합니다. */
  .hero__kw {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.5;
    color: var(--gold);
    margin-bottom: 1.4rem;
  }
  .hero__kw::before {
    content: '';
    flex: none;
    width: 34px;
    height: 2px;
    background: var(--gold);
  }

  .hero h1 {
    color: #fff;
    font-size: clamp(2.15rem, 1.15rem + 4vw, 4rem);
    line-height: 1.16;
    letter-spacing: -0.04em;
    margin-bottom: 1.15rem;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--gold);
  }
  .hero__lead {
    color: var(--dark-ink-2);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    max-width: 27em;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95em 1.7em;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .hero__cta--primary {
    background: var(--gold);
    color: #17130a;
  }
  .hero__cta--primary:hover {
    background: #e6c281;
    color: #17130a;
  }
  .hero__cta--ghost {
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .hero__cta--ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }
  .hero__hours {
    font-size: 0.8125rem;
    color: #7c8697;
    margin: 1.1rem 0 0;
  }

  .hero__photo {
    position: relative;
    width: 100%;
    max-width: 260px;
    margin: 1.5rem auto 0;
    align-self: end;
  }
  /* 좁은 화면에서는 히어로가 길어지지 않도록 조입니다 */
  @media (max-width: 899px) {
    .hero__inner {
      padding-top: 2.25rem;
    }
    .hero__lead {
      margin-bottom: 1.5rem;
    }
    .hero__cta {
      font-size: 0.875rem;
      padding: 0.85em 1.15em;
    }
  }
  @media (min-width: 900px) {
    .hero__photo {
      max-width: 440px;
      margin: 0 0 0 auto;
    }
  }
  .hero__photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* 사진 가장자리를 검정으로 녹여서 인물이 어둠에서 떠오르게 */
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 50% at 52% 38%, rgba(8, 9, 11, 0) 34%, rgba(8, 9, 11, 0.55) 62%, var(--dark-bg) 88%),
      linear-gradient(to top, rgba(8, 9, 11, 0) 74%, var(--dark-bg) 100%),
      linear-gradient(to bottom, rgba(8, 9, 11, 0) 46%, var(--dark-bg) 96%);
    pointer-events: none;
  }

  /* 자격 스트립 */
  .creds {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--dark-line);
  }
  .creds__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.6rem;
    padding-block: 1rem;
  }
  .creds__item {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding-block: 0.35rem;
    font-size: 0.8125rem;
    position: relative;
  }
  .creds__item + .creds__item::before {
    content: '';
    position: absolute;
    left: -0.85rem;
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-50%);
  }
  .creds__item strong {
    color: var(--gold);
    font-weight: 700;
    white-space: nowrap;
  }
  .creds__item span {
    color: var(--dark-ink-2);
  }

  /* ── 히어로 아래 사진 밴드 ───────────────────── */
  .shots {
    background: var(--bg-soft);
    border-bottom: 1px solid var(--line);
  }
  .shots__inner {
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  @media (min-width: 760px) {
    .shots__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  .shots__item {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .shots__item img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* 다크 테마에 맞춰 살짝 눌러줍니다 */
    filter: saturate(0.75) brightness(0.82);
  }
  .shots__item figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(to top, rgba(8, 9, 11, 0.92), rgba(8, 9, 11, 0));
  }

  .more {
    margin: 2rem 0 0;
  }
  .more a {
    font-weight: 700;
    text-decoration: none;
  }
</style>
