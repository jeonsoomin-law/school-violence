---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { ATTORNEY, SITE, ADDRESS, CONTACT } from '../consts';

const crumbs = [{ name: '변호사 소개', href: '/about/' }];

// TODO: 실제 약력으로 교체하세요.
const career = [
  '○○대학교 법학전문대학원 졸업',
  '제○회 변호사시험 합격',
  '前 ○○법률사무소',
  '○○교육지원청 학교폭력대책심의위원회 위원 (예시)',
  '○○시 청소년 법률지원단 자문변호사 (예시)',
];

const focus = [
  '학교폭력대책심의위원회 대응 (가해·피해 양측)',
  '학교폭력 조치 처분 취소 행정심판·행정소송',
  '학교폭력 관련 형사·소년보호사건',
  '사이버폭력·디지털 성범죄 사안',
  '교권 침해 및 학교 안전사고',
];
---

<BaseLayout
  title={`${ATTORNEY.name} 변호사 소개`}
  description={`${SITE.name} ${ATTORNEY.name} ${ATTORNEY.jobTitle}. 학교폭력 사건을 전담하여 학폭위 대응부터 조치 불복 행정심판·행정소송까지 수행합니다.`}
  breadcrumbs={crumbs}
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />

      <div class="ab">
        <div class="ab__photo">
          {
            ATTORNEY.photo ? (
              <img src={ATTORNEY.photo} alt={`${ATTORNEY.name} ${ATTORNEY.jobTitle}`} width="480" height="600" />
            ) : (
              <div class="ab__placeholder">
                <span>프로필 사진</span>
                <small>src/consts.ts 의 ATTORNEY.photo 에 경로를 넣으세요</small>
              </div>
            )
          }
        </div>

        <div class="ab__text">
          <span class="eyebrow">변호사 소개</span>
          <h1>{ATTORNEY.name} {ATTORNEY.jobTitle}</h1>
          <p class="ab__lead">{ATTORNEY.bio}</p>

          <p>
            학교폭력 사건에서 부모님들이 가장 자주 하시는 말씀은 "이렇게 될 줄 몰랐다"입니다. 학교에서
            연락이 왔을 때는 큰일이 아닌 줄 알았고, 아이 말만 믿고 확인서를 그대로 냈는데, 결과를
            받아보니 되돌릴 수 없는 상태가 되어 있었다는 것입니다.
          </p>
          <p>
            학교폭력 절차는 짧고, 한 번 형성된 사실관계는 뒤에서 뒤집기가 매우 어렵습니다. 그래서 저는
            사건을 맡으면 결과를 약속하는 대신, 지금 이 단계에서 무엇이 결정되고 무엇을 준비해야 하는지를
            먼저 정확히 알려드립니다.
          </p>

          <h2>주요 취급 분야</h2>
          <ul class="ab__list">
            {focus.map((f) => <li>{f}</li>)}
          </ul>

          <h2>약력</h2>
          <ul class="ab__list ab__list--plain">
            {career.map((c) => <li>{c}</li>)}
          </ul>

          <h2>사무소 안내</h2>
          <address class="ab__addr">
            {ADDRESS.city} {ADDRESS.street}<br />
            전화 <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a> · 이메일{' '}
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a><br />
            상담시간 {CONTACT.hours}
          </address>
        </div>
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .ab {
    display: grid;
    gap: 2.5rem;
  }
  /* 한 단으로 쌓이는 좁은 화면에서 사진이 화면을 다 먹지 않도록 */
  @media (max-width: 899px) {
    .ab__photo {
      max-width: 300px;
      margin-inline: auto;
      width: 100%;
    }
  }
  @media (min-width: 900px) {
    .ab {
      grid-template-columns: 340px 1fr;
      gap: 3.5rem;
      align-items: start;
    }
    .ab__photo {
      position: sticky;
      top: 5.5rem;
    }
  }
  .ab__photo img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
  .ab__placeholder {
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    background: var(--bg-soft);
    border: 1px dashed var(--line);
    border-radius: var(--radius-lg);
    color: var(--ink-3);
    padding: 1rem;
  }
  .ab__placeholder span {
    font-weight: 700;
  }
  .ab__placeholder small {
    font-size: 0.75rem;
  }

  .ab__text {
    max-width: var(--maxw-prose);
  }
  .ab__lead {
    font-size: 1.0625rem;
    color: var(--ink-2);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .ab__text h2 {
    font-size: 1.15rem;
    margin-top: 2.5rem;
  }
  .ab__list {
    padding-left: 1.1em;
  }
  .ab__list li {
    margin-bottom: 0.45em;
  }
  .ab__list--plain {
    list-style: none;
    padding-left: 0;
  }
  .ab__list--plain li {
    padding-left: 1.1em;
    position: relative;
    color: var(--ink-2);
  }
  .ab__list--plain li::before {
    content: '·';
    position: absolute;
    left: 0.25em;
    color: var(--accent);
    font-weight: 800;
  }
  .ab__addr {
    font-style: normal;
    line-height: 2;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.3rem;
  }
</style>
