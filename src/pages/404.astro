---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../consts';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 존재하지 않습니다." noindex>
  <section class="section nf">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p>주소가 변경되었거나 삭제된 페이지입니다. 아래에서 필요한 내용을 찾아보세요.</p>
      <ul class="nf__links">
        <li><a href="/school-violence/">학교폭력 절차 총정리</a></li>
        <li><a href="/service/">업무분야</a></li>
        <li><a href="/column/">칼럼</a></li>
        <li><a href="/case/">해결사례</a></li>
      </ul>
      <div class="nf__cta">
        <a class="btn btn--primary" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone} 전화상담</a>
        <a class="btn btn--ghost" href="/">홈으로</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    max-width: var(--maxw-prose);
  }
  .nf__links {
    padding-left: 1.1em;
    margin-bottom: 2rem;
  }
  .nf__links li {
    margin-bottom: 0.4em;
  }
  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
