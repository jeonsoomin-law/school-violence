---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, SITE_URL, VERIFICATION, absoluteUrl } from '../consts';
import { organizationSchema, websiteSchema, breadcrumbSchema, type Crumb } from '../lib/schema';

interface Props {
  /** <title> 에 그대로 쓰이는 문구. 사이트명은 자동으로 뒤에 붙습니다. */
  title: string;
  /** 메타 디스크립션. 페이지마다 반드시 다르게. */
  description: string;
  /** OG 이미지 (public 기준 경로) */
  image?: string;
  /** 색인 제외 */
  noindex?: boolean;
  /** 빵부스러기 (홈은 자동 포함) */
  breadcrumbs?: Crumb[];
  /** 페이지 고유 구조화 데이터 */
  jsonLd?: Record<string, unknown>[];
  /** 사이트명을 title 뒤에 붙이지 않음 (홈에서 사용) */
  bareTitle?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  noindex = false,
  breadcrumbs = [],
  jsonLd = [],
  bareTitle = false,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE_URL + '/').href;

const crumbs: Crumb[] = [{ name: '홈', href: '/' }, ...breadcrumbs];
const schemas: Record<string, unknown>[] = [
  organizationSchema(),
  websiteSchema(),
  ...(breadcrumbs.length ? [breadcrumbSchema(crumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <!-- Open Graph / 카카오톡·페이스북 공유 미리보기 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteUrl(image)} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 검색엔진 소유확인 -->
    {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
    {VERIFICATION.naver && <meta name="naver-site-verification" content={VERIFICATION.naver} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} 칼럼`} href="/rss.xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <JsonLd data={schemas} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyCta />
  </body>
</html>
